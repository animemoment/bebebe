// Тени агентов в вершинном шейдере (PLAN.md §15.5, шаг G4).
// Перенос CPU-растяжения силуэта из AgentRenderer._Process в GPU.
//
// Старая математика CPU (сохранена бит-в-бит визуально):
//   sLen = LengthPx + 16, sLenN = sLen / 32, sWdtN = WidthScale,
//   perp = (-sdy, sdx), якорь = sun_dir * (sLen * 0.5 - 8) (сдвиг от центра к ногам).
//   Матрица инстанса была: базис (sdx*sLenN, sdy*sLenN / perp*sWdtN) + трансляция
//   (px + anchor.x, py + 16 + anchor.y). Локальные ±16px квада давали мировые
//   ±len/2 по длине и ±wdt/2 по ширине.
//
// Новая схема: CPU пишет в теневой буфер ТОЛЬКО трансляцию
//   (единичная матрица + ox = px + anchor.x, oy = py + 16 + anchor.y),
// а растяжение делает этот шейдер из локальных координат квада.
//
// ПОРЯДОК ПРИМЕНЕНИЯ (предположение, зафиксированное здесь):
//   в canvas_item VERTEX в vertex() — это локальная вершина квада (±16px)
//   ДО instance-матрицы MultiMesh; движок умножает результат vertex()
//   на instance-трансформ (трансляцию с якорем) поверх. Поэтому шейдер делает
//   ЧИСТО линейное преобразование локального квада (без трансляции!):
//   локальный x -> вдоль солнца (длина), локальный y -> поперёк (ширина).
//   Якорь в шейдере НЕ добавляется — он уже сидит в instance-трансляции CPU,
//   иначе был бы двойной сдвиг (uniform sun_anchor_shift оставлен для
//   отладки/паритета и будущего варианта, в transform не участвует).
//   UV/COLOR/fragment не трогаем: текстура и Modulate-альфа идут дефолтным
//   путём canvas_item (тот же квад 32x32 и та же текстура, что у тел).
//
// КАК ПРОВЕРИТЬ ВИЗУАЛЬНО: утро — длинная тень влево, полдень — тени скрыты
//   (Visible=false), вечер — вправо; скрины утро/полдень/вечер должны совпасть
//   со старым CPU-путём (fallback за флагом _shadowUseShader в AgentRenderer).
//   Если тень едет вдвое дальше / от центра, а не от ног — значит предположение
//   о порядке неверно: тогда якорь надо перенести из CPU-трансляции сюда
//   (VERTEX += sun_anchor_shift) и писать в буфер чистые (px, py+16).
shader_type canvas_item;

// Единичное направление солнца (SunState.Dir). При Dir=(0,0) (ночь/полдень)
// квад схлопывается в точку, но инстансы всё равно скрыты через Visible=false.
uniform vec2 sun_dir = vec2(1.0, 0.0);
// Нормированная длина тени: sLenN = (LengthPx + 16) / 32.
uniform float sun_len_n = 1.0;
// Нормированная ширина: sWdtN = WidthScale (0.55).
uniform float sun_width_n = 0.55;
// Сдвиг якоря в px (= sun_dir * (sLen * 0.5 - 8)). Применяется на CPU
// в instance-трансляции, здесь НЕ используется (см. шапку). Хранится для паритета.
uniform vec2 sun_anchor_shift = vec2(0.0, 0.0);
// Размер квада в px (32x32). Документирует масштаб; в математике не нужен,
// т.к. VERTEX уже в пикселях локального квада (±16).
uniform vec2 quad_size = vec2(32.0, 32.0);

void vertex() {
	// Перпендикуляр к солнцу (ширина тени).
	vec2 perp = vec2(-sun_dir.y, sun_dir.x);
	vec2 v = VERTEX;
	// Линейное растяжение локального квада: x — вдоль солнца, y — поперёк.
	// Instance-матрица (трансляция с якорем у ног) применяется движком поверх.
	VERTEX = vec2(
		sun_dir.x * v.x * sun_len_n + perp.x * v.y * sun_width_n,
		sun_dir.y * v.x * sun_len_n + perp.y * v.y * sun_width_n
	);
}
