using Godot;
using Game.Core.WorldStreaming;

namespace Game.UI.Streaming;

public partial class WorldMapController : Control
{
	[Signal] public delegate void RegionSelectedEventHandler(int x, int y);
	[Signal] public delegate void CloseRequestedEventHandler();

	[Export] public TileMapLayer MapLayer;
	[Export] public Button CloseButton;

	[Export] public ulong WorldSeed = 0x0123456789ABCDEFUL;
	[Export] public uint GeneratorVersion = 3;

	private ColorRect _backdrop;

	public override void _Ready()
	{
		// Полноэкранный модальный оверлей.
		SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);
		OffsetLeft = 0; OffsetTop = 0; OffsetRight = 0; OffsetBottom = 0;
		MouseFilter = MouseFilterEnum.Stop;
		ClipContents = true;
		ZIndex = 1000;

		// 1) Непрозрачный фон ПЕРВЫМ ребёнком -> перекрывает игру целиком.
		_backdrop = new ColorRect
		{
			Name = "Backdrop",
			Color = new Color(0.06f, 0.07f, 0.09f, 1f),
			MouseFilter = MouseFilterEnum.Ignore,
			ZIndex = 0
		};
		_backdrop.SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);
		AddChild(_backdrop);
		_backdrop.MoveChild(_backdrop, 0);

		// 2) Ищем узлы сцены.
		MapLayer ??= GetNodeOrNull<TileMapLayer>("TileMapLayer");
		CloseButton ??= GetNodeOrNull<Button>("BtnOpenWorldMap");
		if (CloseButton == null) CloseButton = GetNodeOrNull<Button>("ButtonMap");

		// Fallback: любая кнопка-ребёнок.
		if (CloseButton == null)
		{
			foreach (var child in GetChildren())
			{
				if (child is Button b) { CloseButton = b; break; }
			}
		}

		if (CloseButton != null)
		{
			CloseButton.ZIndex = 10;
			CloseButton.MouseFilter = MouseFilterEnum.Stop;
			CloseButton.Pressed += () => EmitSignal(SignalName.CloseRequested);
		}
		else
		{
			GD.PrintErr("[WorldMapController] no close button found (BtnOpenWorldMap/ButtonMap)");
		}

		// 3) Заполняем тайлы через mapper.
		if (MapLayer != null)
		{
			MapLayer.ZIndex = 1;
			var mapper = new WorldMapTileMapper { Name = "WorldMapTileMapper" };
			AddChild(mapper);
			mapper.Initialize(WorldSeed, GeneratorVersion, MapLayer);

			// 4) ГЛАВНОЕ ДЛЯ ВИДИМОСТИ: растягиваем уже сгенерированные тайлы на весь экран.
			FitMapLayerToViewport();
		}
		else
		{
			GD.PrintErr("[WorldMapController] TileMapLayer not found in WorldMap.tscn");
		}
	}

	private void FitMapLayerToViewport()
	{
		if (MapLayer == null) return;

		var rect = GetViewport().GetVisibleRect();
		var ts = MapLayer.TileSet != null ? MapLayer.TileSet.TileSize : new Vector2I(16, 16);
		if (ts.X <= 0) ts.X = 16;
		if (ts.Y <= 0) ts.Y = 16;

		// Mapper заполняет радиус 8 чанков => 17 тайлов по оси (denom = 16 для точного покрытия краёв).
		const int radius = 8;
		float denomX = (2 * radius);
		float denomY = (2 * radius);

		float sx = rect.Size.X / (denomX * (float)ts.X);
		float sy = rect.Size.Y / (denomY * (float)ts.Y);

		MapLayer.Scale = new Vector2(sx, sy);
		MapLayer.Position = rect.Size * 0.5f; // тайл (0,0) в центр экрана

		GD.Print($"[WorldMapController] fitted: scale=({sx:F2},{sy:F2}) pos={MapLayer.Position} tile={ts}");
	}

	public override void _Input(InputEvent @event)
	{
		if (@event is InputEventKey key && key.Pressed && !key.Echo && key.Keycode == Key.Escape)
		{
			EmitSignal(SignalName.CloseRequested);
			GetViewport().SetInputAsHandled();
		}
	}

	public override void _GuiInput(InputEvent @event)
	{
		if (@event is InputEventMouseButton mb && mb.Pressed && mb.ButtonIndex == MouseButton.Left)
		{
			if (TryGetRegionFromGlobalPoint(mb.GlobalPosition, out int rx, out int ry))
			{
				AcceptEvent();
				EmitSignal(SignalName.RegionSelected, rx, ry);
			}
		}
	}

	private bool TryGetRegionFromGlobalPoint(Vector2 globalPoint, out int regionX, out int regionY)
	{
		regionX = -1; regionY = -1;
		if (MapLayer == null) return false;

		Vector2 local = MapLayer.ToLocal(globalPoint);
		Vector2I tile = MapLayer.LocalToMap(local);

		long per = WorldRegions.TilesPerRegionAxis;
		if (per <= 0) per = 8;

		long wtx = WorldRegions.WorldRegionsX * per;
		long wty = WorldRegions.WorldRegionsY * per;

		// Mapper пока кладёт чанки вокруг нуля; клики вне диапазона игнорируем.
		if (tile.X < -wtx || tile.X > wtx || tile.Y < -wty || tile.Y > wty) return false;

		regionX = (int)(tile.X / per);
		regionY = (int)(tile.Y / per);
		if (regionX < 0) regionX = 0;
		if (regionY < 0) regionY = 0;
		return true;
	}
}
