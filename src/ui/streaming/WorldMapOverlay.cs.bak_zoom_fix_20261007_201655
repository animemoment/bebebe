using Godot;
using System;
using System.Collections.Generic;
using Game.Core.WorldStreaming;
using System.Threading.Tasks;

namespace Game.UI.Streaming;

public partial class WorldMapOverlay : CanvasLayer
{
    private const int MapWidth = 2048;   // регионов по X (ширина мира)
    private const int MapHeight = 1024;  // регионов по Y (высота мира)

    /// <summary>Сид мира.</summary>
    public ulong WorldSeed;

    /// <summary>Версия генератора.</summary>
    public uint GeneratorVersion;

    /// <summary>Центр камеры в КЛЕТКАХ мировой сетки.</summary>
    public Func<Vector2> CameraCenterProvider;

    /// <summary>Половина видимой области камеры в КЛЕТКАХ.</summary>
    public Func<Vector2> CameraHalfExtentProvider;

    /// <summary>Телепорт в указанный регион.</summary>
    public Action<RegionKey> OnTeleport;

    /// <summary>Открыта ли мировая карта.</summary>
    public bool IsOpen => Visible;

    // ---------- Состояние панорамирования и зума ----------
    private Vector2 _containerOffset;
    private float _containerScale = 1f;
    private bool _isDragging;
    private float _dragStartX;
    private float _dragStartY;
    private float _dragOffsetX;
    private float _dragOffsetY;

    // ---------- Вычисленные размеры ----------
    private float _displayWidth;
    private float _displayHeight;
    private bool _textureRequested;

    // ---------- Визуальные элементы ----------
    private Control _root;
    private Control _container;
    private TextureRect _map;
    private ColorRect _viewMarker;
    private Label _info;
    private readonly ColorRect[] _borders = new ColorRect[4];

    public override void _Ready()
    {
        Layer = 50;

        // Корневой Control - растягивается на весь экран вручную.
        _root = new Control
        {
            Name = "WorldMapRoot",
            MouseFilter = Control.MouseFilterEnum.Ignore
        };
        AddChild(_root);
        _root.SetAnchorsAndOffsetsPreset(Control.LayoutPreset.FullRect);

        // Контейнер-обёртка: Scale от центра экрана (ручной offset), перехват ввода.
        _container = new Control
        {
            Name = "MapContainer",
            MouseFilter = Control.MouseFilterEnum.Stop
        };
        _root.AddChild(_container);

        // Текстурная нода карты.
        _map = new TextureRect
        {
            Name = "MAP",
            MouseFilter = Control.MouseFilterEnum.Ignore,
            StretchMode = TextureRect.StretchModeEnum.Scale,
    CustomMinimumSize = new Vector2(1920f, 1080f)
        };
        _container.AddChild(_map);

        // Белые рамки контейнера.
        var white = new Color(1f, 1f, 1f, 0.86f);
        for (int i = 0; i < 4; i++)
        {
            _borders[i] = new ColorRect
            {
                Name = $"Border{i}",
                Color = white,
                MouseFilter = Control.MouseFilterEnum.Ignore
            };
            _container.AddChild(_borders[i]);
        }

        // Жёлтый маркер видимой области камеры.
        _viewMarker = new ColorRect
        {
            Name = "ViewMarker",
            Color = new Color(1f, 0.95f, 0.2f, 0.4f),
            MouseFilter = Control.MouseFilterEnum.Ignore
        };
        _container.AddChild(_viewMarker);

        // Инфо-панель.
        _info = new Label
        {
            Name = "MapInfo",
            Position = new Vector2(12f, 10f),
            MouseFilter = Control.MouseFilterEnum.Ignore
        };
        _info.AddThemeFontSizeOverride("font_size", 16);
        _root.AddChild(_info);

        Visible = false;
    }

    public override void _Process(double delta)
    {
        if (!Visible) return;
        UpdateViewMarker();
        UpdateInfo();
    }

    public override void _UnhandledInput(InputEvent @event)
    {
        if (!Visible) return;

        // Escape / O закрывают карту.
        if (@event is InputEventKey key && key.Pressed && !key.Echo)
        {
            if (key.Keycode == Key.Escape || key.Keycode == Key.O)
            {
                Close();
                GetViewport().SetInputAsHandled();
                return;
            }

            // WASD / Стрелки - панорамирование карты.
            float basePanSpeed = Input.IsKeyPressed(Key.Shift) ? 60f : 20f;
float panSpeed = basePanSpeed / Math.Max(_containerScale, 0.1f);
            bool panned = false;
            if (key.Keycode == Key.W || key.Keycode == Key.Up)       { _containerOffset.Y -= panSpeed; panned = true; }
            if (key.Keycode == Key.S || key.Keycode == Key.Down)     { _containerOffset.Y += panSpeed; panned = true; }
            if (key.Keycode == Key.A || key.Keycode == Key.Left)     { _containerOffset.X -= panSpeed; panned = true; }
            if (key.Keycode == Key.D || key.Keycode == Key.Right)    { _containerOffset.X += panSpeed; panned = true; }
            if (panned)
            {
                SetContainerTransform();
                GetViewport().SetInputAsHandled();
                return;
            }
            return;
        }

        // Мышь: ЛКМ - начало драга.
        if (@event is InputEventMouseButton mouse && mouse.Pressed && mouse.ButtonIndex == MouseButton.Left)
        {
            var mp = GetViewport().GetMousePosition();
            if (mp.Y < 50f) return;

            _isDragging = true;
            _dragStartX = mp.X;
            _dragStartY = mp.Y;
            _dragOffsetX = _containerOffset.X;
            _dragOffsetY = _containerOffset.Y;
            return;
        }

        // Отпускание ЛКМ.
        if (_isDragging && @event is InputEventMouseButton release && !release.Pressed
            && release.ButtonIndex == MouseButton.Left)
        {
            var mp = GetViewport().GetMousePosition();
            float dx = Math.Abs(mp.X - _dragStartX);
            float dy = Math.Abs(mp.Y - _dragStartY);

            // Не клик если двигались хотя бы по одной оси > 4px.
            if (!(dx > 4f || dy > 4f))
            {
                // Клик - телепорт.
                int rx = ScreenToRegionX((int)mp.X);
                int ry = ScreenToRegionY((int)mp.Y);
                if (rx >= 0 && rx < MapWidth && ry >= 0 && ry < MapHeight)
                    OnTeleport?.Invoke(new RegionKey(rx, ry));
                GetViewport().SetInputAsHandled();
            }
            _isDragging = false;
            return;
        }

        // Дра正在进行中 - панорамирование мышью.
        if (_isDragging && @event is InputEventMouseMotion motion)
        {
            _containerOffset = new Vector2(
                _dragOffsetX + motion.Position.X - _dragStartX,
                _dragOffsetY + motion.Position.Y - _dragStartY);
            SetContainerTransform();
            return;
        }

        // Колёсико - зум.
        if (@event is InputEventMouseButton wkb
            && (wkb.ButtonIndex == MouseButton.WheelUp || wkb.ButtonIndex == MouseButton.WheelDown))
        {
            ApplyZoom(wkb.Factor);
            return;
        }
    }

    private void ApplyZoom(float scrollDelta)
    {
        const float deadZone = 0.05f;
        if (Math.Abs(scrollDelta) < deadZone) return;

        float sensitivity = 0.004f;
        float delta = scrollDelta * sensitivity;

        float oldScale = _containerScale;
        _containerScale += delta;
        _containerScale = Math.Clamp(_containerScale, 8f, 50f);

        if (Math.Abs(_containerScale - oldScale) < 0.001f) return;
        SetContainerTransform();
    }

    private void SetContainerTransform()
    {
        if (_container == null) return;
        Vector2 viewportSize = _root.Size;
        if (viewportSize.X <= 0f || viewportSize.Y <= 0f)
            viewportSize = GetViewport().GetVisibleRect().Size;
        if (viewportSize.X <= 0f || viewportSize.Y <= 0f) return;

        Vector2 scaledMapSize = new Vector2(MapWidth, MapHeight) * _containerScale;
        _container.Position = new Vector2(
            (viewportSize.X - scaledMapSize.X) * 0.5f + _containerOffset.X,
            (viewportSize.Y - scaledMapSize.Y) * 0.5f + _containerOffset.Y);
        _container.Scale = new Vector2(_containerScale, _containerScale);
        LayoutBorders();
    }

    public void Open()
    {
        Visible = true;

        // Закрываем все открытые меню HUD.
        CloseOtherUIs();

        LayoutMapInitial();
        if (!_textureRequested)
        {
            _textureRequested = true;
            _ = BuildTileMapAsync();
        }
    }

    private static IEnumerable<Node> EnumerateDescendants(Node parent)
    {
        if (parent == null) yield break;
        foreach (Node child in parent.GetChildren())
        {
            yield return child;
            foreach (var gchild in EnumerateDescendants(child))
                yield return gchild;
        }
    }

    private void CloseOtherUIs()
    {
        // Ищем HUDController и скрываем его контейнеры.
        var hud = ((Engine.GetMainLoop() as SceneTree)?.Root)?.FindChild("HUDController", true, false) as HUDController;
        if (hud != null)
            hud.HideContainers();

        // Пытаемся закрыть BuildMenu, FarmController, WorkZoneController.
        var tree = Engine.GetMainLoop() as SceneTree;
        if (tree != null)
        {
            foreach (var child in EnumerateDescendants(tree.Root))
            {
                string name = child.Name;
                if (name.Contains("BuildMenu") ||
                    name.Contains("FarmController") ||
                    name.Contains("WorkZone"))
                {
                    if (child is Control ctl)
                        ctl.Visible = false;
                }
            }
        }
    }

    public void Close() => Visible = false;

    public void Toggle()
    {
        if (Visible) Close();
        else Open();
    }

    // ========== Генерация тайловой карты из атласа ==========

    private async Task BuildTileMapAsync()
    {
        byte[] pixels = await Task.Run(BuildTilePixels);
        if (!IsInsideTree()) return;

        Image img = Image.CreateFromData(MapWidth, MapHeight, false, Image.Format.Rgba8, pixels);
        img.GenerateMipmaps();
        _map.Texture = ImageTexture.CreateFromImage(img);
        LayoutBorders();
    }

    private byte[] BuildTilePixels()
    {
        byte[] pixels = new byte[MapWidth * MapHeight * 4];
        int offset = 0;

        // Загружаем атлас ForWorldMap.png для выборки цветов тайлов.
        Image atlas = null;
        try
        {
            var atlasTex = ResourceLoader.Load<Texture2D>("res://ui/assets/textures/map/ForWorldMap.png");
                atlas = atlasTex?.GetImage();
        }
        catch { /* ignore */ }

        // Маппинг source_index -> col, row в атласе 16x16px/тайл.
        // Atlas grid: 10 columns x ~3 rows.
        Dictionary<int, (int col, int row)> positions = new()
        {
            [0]  = (0, 0),  [1]  = (0, 1),  [2]  = (0, 2),  // Desert variants
            [3]  = (1, 0),  [4]  = (1, 1),  [5]  = (1, 2),  // Steppe variants
            [6]  = (2, 0),  [7]  = (2, 1),  [8]  = (2, 2),  // Water variants
            [9]  = (3, 0),                                           // Mountain
            [10] = (4, 0),                                          // Plains
            [11] = (5, 0),                                          // Swamp
            [12] = (6, 0), [13] = (7, 0), [14] = (8, 0), [15] = (9, 0) // Forest variants
        };

        int atlasW = atlas?.GetWidth() ?? 0;
        int atlasH = atlas?.GetHeight() ?? 0;
        bool hasAtlas = atlas != null && atlasW > 0 && atlasH > 0;

        for (int iy = 0; iy < MapHeight; iy++)
        {
            for (int ix = 0; ix < MapWidth; ix++)
            {
                var region = new RegionKey(ix, iy);
                RegionTraits t = RegionTraitProvider.Sample(WorldSeed, GeneratorVersion, region);
                TilePick pick = BiomeMapper.Pick(WorldSeed, GeneratorVersion, region.X, region.Y, t);
                int srcIdx = BiomeSourceIndex(pick.Biome, pick.Variant);

                if (hasAtlas && positions.TryGetValue(srcIdx, out var pos))
                {
                    int px = pos.col * 16 + 8; // центр тайла 16x16
                    int py = pos.row * 16 + 8;
                    px = Math.Min(Math.Max(px, 0), atlasW - 1);
                    py = Math.Min(Math.Max(py, 0), atlasH - 1);

                    Color c = atlas.GetPixel(px, py);
                    byte r = (byte)(c.R * 255f);
                    byte g = (byte)(c.G * 255f);
                    byte b = (byte)(c.B * 255f);
                    pixels[offset++] = r;
                    pixels[offset++] = g;
                    pixels[offset++] = b;
                    pixels[offset++] = 255;
                }
                else
                {
                    // Fallback solid color по biome.
                    Color fallback = FallbackColor(srcIdx);
                    pixels[offset++] = (byte)(fallback.R * 255f);
                    pixels[offset++] = (byte)(fallback.G * 255f);
                    pixels[offset++] = (byte)(fallback.B * 255f);
                    pixels[offset++] = 255;
                }
            }
        }

        return pixels;
    }

    private static int BiomeSourceIndex(BiomeType biome, int variant)
    {
        int v = Math.Clamp(variant, 0, 2);
        return biome switch
        {
            BiomeType.Desert    => v,                       // 0,1,2
            BiomeType.Steppe    => 3 + v,                   // 3,4,5
            BiomeType.DeepWater => 6 + v,                   // 6,7,8
            BiomeType.Mountain  => 9,                       // 9
            BiomeType.Plains    => 10,                      // 10
            BiomeType.Swamp     => 11,                      // 11
            BiomeType.Forest    => 12 + Math.Clamp(variant, 0, 3), // 12..15
            _                   => 10
        };
    }

    private static Color FallbackColor(int srcIdx)
    {
        return srcIdx switch
        {
            0 or 1 or 2 => new Color(0.85f, 0.80f, 0.55f), // Desert
            3 or 4 or 5 => new Color(0.65f, 0.70f, 0.40f), // Steppe
            6 or 7 or 8 => new Color(0.20f, 0.40f, 0.70f), // Water
            9           => new Color(0.50f, 0.45f, 0.40f), // Mountain
            10          => new Color(0.45f, 0.65f, 0.35f), // Plains
            11          => new Color(0.30f, 0.45f, 0.25f), // Swamp
            _           => new Color(0.30f, 0.55f, 0.30f), // Forest
        };
    }

    // ===== Раскладка =====

    private void LayoutMapInitial()
    {
        _containerOffset = Vector2.Zero;

        Vector2 viewportSize = _root.Size;
        if (viewportSize.X <= 0f || viewportSize.Y <= 0f)
            viewportSize = GetViewport().GetVisibleRect().Size;
        if (viewportSize.X <= 0f || viewportSize.Y <= 0f) return;

        // Fit the complete map in the viewport; clicks and pan/zoom use this same scale.
        _containerScale = 14f; // Показывает ~7% мира по умолчанию (масштаб 8f..50f)
        _displayWidth = MapWidth * _containerScale;
        _displayHeight = MapHeight * _containerScale;

        var mapSize = new Vector2(MapWidth, MapHeight);
        _container.Size = mapSize;
        _map.Position = Vector2.Zero;
        _map.Size = mapSize;
        SetContainerTransform();
    }

    private void LayoutBorders()
    {
        if (_container == null) return;
        Vector2 size = _container.Size;
        if (size.X <= 0 || size.Y <= 0) return;

        _borders[0].Position = new Vector2(0, 0);
        _borders[0].Size = new Vector2(size.X, 3f);       // Top
        _borders[1].Position = new Vector2(0, size.Y - 3f);
        _borders[1].Size = new Vector2(size.X, 3f);       // Bottom
        _borders[2].Position = new Vector2(0, 0);
        _borders[2].Size = new Vector2(3f, size.Y);       // Left
        _borders[3].Position = new Vector2(size.X - 3f, 0);
        _borders[3].Size = new Vector2(3f, size.Y);       // Right
    }

    // ===== Обновление UI =====

    private void UpdateViewMarker()
    {
        if (CameraCenterProvider == null || CameraHalfExtentProvider == null || _displayWidth <= 0) return;

        Vector2 center = CameraCenterProvider();
        Vector2 half = CameraHalfExtentProvider();

        long rx0 = ClampX(WorldRegions.RegionForCell((long)Math.Floor(center.X - half.X), 0).X);
        long rx1 = ClampX(WorldRegions.RegionForCell((long)Math.Floor(center.X + half.X), 0).X);
        long ry0 = ClampY((long)Math.Floor(center.Y - half.Y));
        long ry1 = ClampY((long)Math.Floor(center.Y + half.Y));

        _viewMarker.Position = new Vector2(rx0, ry0) * _containerScale;
        _viewMarker.Size = new Vector2(Math.Max(1f, rx1 - rx0), Math.Max(1f, ry1 - ry0)) * _containerScale;
    }

    private void UpdateInfo()
    {
        Vector2 mouse = GetViewport().GetMousePosition();
        if (_displayWidth <= 0 || _containerScale <= 0f) { _info.Text = ""; return; }

        int regionX = ScreenToRegionX((int)mouse.X);
        int regionY = ScreenToRegionY((int)mouse.Y);

        if (regionX < 0 || regionX >= MapWidth || regionY < 0 || regionY >= MapHeight)
        {
            _info.Text = "";
            return;
        }

        RegionTraits t = RegionTraitProvider.Sample(WorldSeed, GeneratorVersion, new RegionKey(regionX, regionY));
        _info.Text =
            $"Регион ({regionX}, {regionY})\n" +
            $"Влага: {t.MoistureQ16 * 100 / ushort.MaxValue}%  Вода: {t.WaterQ16 * 100 / ushort.MaxValue}%  Лес: {t.ForestQ16 * 100 / ushort.MaxValue}%\n" +
            $"Камень: {t.StoneQ16 * 100 / ushort.MaxValue}%  Рельеф: {t.ElevationQ16 * 100 / ushort.MaxValue}%\n" +
            $"Клик - телепорт, O/Esc - закрыть";
    }

    // ===== Координаты =====

    private int ScreenToRegionX(int screenX)
    {
        if (_container == null || _containerScale <= 0f) return -1;
        double texX = (screenX - _container.Position.X) / _containerScale;
        return texX >= 0d && texX < MapWidth ? (int)Math.Floor(texX) : -1;
    }

    private int ScreenToRegionY(int screenY)
    {
        if (_container == null || _containerScale <= 0f) return -1;
        double texY = (screenY - _container.Position.Y) / _containerScale;
        return texY >= 0d && texY < MapHeight ? (int)Math.Floor(texY) : -1;
    }

    private static long ClampX(long x) => Math.Clamp(x, 0L, MapWidth - 1L);
    private static long ClampY(long y) => Math.Clamp(y, 0L, MapHeight - 1L);
}
