using Godot;
using Game.Core.WorldStreaming;

namespace Game.UI.Streaming;

public partial class WorldMapController : Control
{
	[Signal] public delegate void RegionSelectedEventHandler(int x, int y);
	[Signal] public delegate void CloseRequestedEventHandler();

	[Export] public TileMapLayer MapLayer;
	[Export] public Button CloseButton;

	[Export] public ulong WorldSeed = 0x0123456789ABCDEFUL;
	[Export] public uint GeneratorVersion = 3;

	public override void _Ready()
	{
		SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);
		MouseFilter = MouseFilterEnum.Stop;
		ClipContents = true;

		MapLayer ??= GetNodeOrNull<TileMapLayer>("TileMapLayer");
		CloseButton ??= GetNodeOrNull<Button>("ButtonMap");

		if (CloseButton != null)
		{
			CloseButton.ZIndex = 10;
			CloseButton.Pressed += () => EmitSignal("close_requested");
		}
		else
		{
			GD.PrintErr("[WorldMapController] ButtonMap not found in WorldMap.tscn");
		}

		if (MapLayer != null)
		{
			var mapper = new WorldMapTileMapper { Name = "WorldMapTileMapper" };
			AddChild(mapper);
			mapper.Initialize(WorldSeed, GeneratorVersion, MapLayer);
		}
		else
		{
			GD.PrintErr("[WorldMapController] TileMapLayer not found in WorldMap.tscn");
		}
	}

	public override void _Input(InputEvent @event)
	{
		if (@event is InputEventKey key && key.Pressed && !key.Echo && key.Keycode == Key.Escape)
		{
			EmitSignal("close_requested");
			@event.SetHandled();
		}
	}

	public override void _GuiInput(InputEvent @event)
	{
		if (@event is InputEventMouseButton mb && mb.Pressed && mb.ButtonIndex == MouseButton.Left)
		{
			if (TryGetRegionFromGlobalPoint(mb.GlobalPosition, out int rx, out int ry))
			{
				mb.SetHandled();
				EmitSignal("region_selected", rx, ry);
			}
		}
	}

	private bool TryGetRegionFromGlobalPoint(Vector2 globalPoint, out int regionX, out int regionY)
	{
		regionX = -1;
		regionY = -1;

		if (MapLayer == null)
			return false;

		Vector2 local = MapLayer.ToLocal(globalPoint);
		Vector2I tile = MapLayer.LocalToMap(local);

		long tilesPerRegion = WorldRegions.TilesPerRegionAxis;
		long worldTilesX = WorldRegions.WorldRegionsX * tilesPerRegion;
		long worldTilesY = WorldRegions.WorldRegionsY * tilesPerRegion;

		if (tile.X < 0 || tile.Y < 0 || tile.X >= worldTilesX || tile.Y >= worldTilesY)
			return false;

		regionX = (int)(tile.X / tilesPerRegion);
		regionY = (int)(tile.Y / tilesPerRegion);

		return true;
	}
}
