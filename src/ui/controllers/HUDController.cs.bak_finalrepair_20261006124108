    private Button _buttonMap; // Сохраняем ссылку для защиты от дубликатов

    /// <summary>Привязать кнопку ButtonMap (глобальная карта §23/§24) к переключению оверлея.</summary>
    public void BindWorldMapButton(Action onPressed)
    {
        if (onPressed == null || _buttonMap != null) return; // Защита от двойной подписки
        
        var button = FindChild("ButtonMap", true, false) as Button;
        if (button == null)
        {
            GD.PrintErr("[HUD] ButtonMap НЕ найден через FindChild!");
            foreach (var child in GetChildren())
                GD.Print($"[HUD] Дети: {child.Name} ({child.GetType().Name})");
            return;
        }
        
        _buttonMap = button;
        _buttonMap.MouseFilter = Control.MouseFilterEnum.Stop;
        
        // Поднимаем кнопку наверх — переносим в конец дерева children
        // Теперь она рисуется поверх всех PanelContainer'ов
        RemoveChild(_buttonMap);
        AddChild(_buttonMap);
        
        _buttonMap.Pressed += () =>
        {
            GD.Print("[HUD BUTTONMAP!] clicked -> invoking");
            onPressed?.Invoke();
        };
        GD.Print("[HUD] ButtonMap bound OK");
    }

    private static void SetMouseFilterRecursive(Control control)
    {
        if (control is not BaseButton)
        {
            control.MouseFilter = MouseFilterEnum.Ignore;
        }

        foreach (Node child in control.GetChildren())
        {
            if (child is Control childControl)
                SetMouseFilterRecursive(childControl);
        }
    }

